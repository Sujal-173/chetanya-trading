# ---------------------------------------------------------------------------
# CHAITANYA Trading Consultancy: environment variables
# Copy to .env.local for development. On the host (e.g. Vercel) add the same
# names in the project's environment settings.
# Anything starting with NEXT_PUBLIC_ is visible in the browser. Never put a
# secret in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Site (required in production) -----------------------------------------
# Your real domain, no trailing slash. Drives canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Contact details (leave blank until verified; blank values are hidden) ---
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=
# Digits with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP=
# Public office address lines, separated by | (street, area...). City below is added automatically.
NEXT_PUBLIC_ADDRESS_LINES=
NEXT_PUBLIC_CITY=Indore
NEXT_PUBLIC_REGION=Madhya Pradesh
NEXT_PUBLIC_COUNTRY=India
NEXT_PUBLIC_POSTAL_CODE=
# Free text, e.g. Monday to Saturday, 10:00 to 18:00 IST
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# --- Legal and regulatory (only fill in what is verified) -------------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_REGISTERED_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
# Shown on the site ONLY when a number is set. Never add one unless verified
# against the regulator's official register.
NEXT_PUBLIC_REGULATORY_AUTHORITY=SEBI
NEXT_PUBLIC_REGULATORY_REGISTRATION_TYPE=
NEXT_PUBLIC_REGULATORY_REGISTRATION_NUMBER=

# --- Services ----------------------------------------------------------------
# Set to true ONLY if "Ongoing Market Guidance" is genuinely offered.
NEXT_PUBLIC_OFFER_ONGOING_GUIDANCE=false

# --- First-visit popup -------------------------------------------------------
NEXT_PUBLIC_POPUP_ENABLED=true
NEXT_PUBLIC_POPUP_DELAY_MS=7000

# --- Google Sheets lead capture (server only) --------------------------------
# See docs/GOOGLE-SHEETS-SETUP.md
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Lead Enquiries
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON file inside double quotes, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=

# --- Upstash Redis (server only, strongly recommended in production) ----------
# Gives shared rate limiting, duplicate detection and a durable fallback queue
# if Google Sheets is briefly unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional bot protection: Cloudflare Turnstile ---------------------------
# Leave both blank to rely on the honeypot, timing check and rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
